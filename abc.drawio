        <mxCell id="n_start" parent="1" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Times New Roman;" value="&lt;b&gt;1. KHỞI TẠO ĐƠN HÀNG&lt;/b&gt;&lt;br&gt;Nhập chuỗi lô hàng &amp;amp; Bấm xử lý trên Web UI" vertex="1">
          <mxGeometry height="70" width="260" x="360" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n_init" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Times New Roman;" value="&lt;b&gt;TÍNH TOÁN &amp;amp; KHỞI TẠO BỘ NHỚ&lt;/b&gt;&lt;br&gt;- Tính đường đi, đếm tầng/thùng (Excel)&lt;br&gt;- Khởi tạo: &lt;i&gt;amr_status = IDLE&lt;/i&gt;&lt;br&gt;- Gán: &lt;i&gt;remaining_boxes = N&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="260" x="360" y="200" as="geometry" />
        </mxCell>
        <mxCell id="n_amr_get" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;" value="&lt;b&gt;2. LIÊN TỤC HỎI ĐƯỜNG (POLLING)&lt;/b&gt;&lt;br&gt;GET /api/amr/next_step" vertex="1">
          <mxGeometry height="60" width="260" x="40" y="310" as="geometry" />
        </mxCell>
        <mxCell id="n_srv_move" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Times New Roman;" value="&lt;b&gt;ĐIỀU HƯỚNG AMR&lt;/b&gt;&lt;br&gt;Trả về Mã Đích (Ví dụ: 17L)&lt;br&gt;Gán &lt;i&gt;amr_status = MOVING&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="260" x="360" y="310" as="geometry" />
        </mxCell>
        <mxCell id="n_cob_wait" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Times New Roman;" value="&lt;b&gt;3. COBOT HỎI VIỆC&lt;/b&gt;&lt;br&gt;GET /api/cobot/current_task&lt;br&gt;&lt;font color=&#39;#ff0000&#39;&gt;(Server thấy chữ MOVING -&amp;gt; Ép Cobot&lt;br&gt;nhận status &amp;quot;waiting_amr&amp;quot; và đứng im)&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="260" x="800" y="320" as="geometry" />
        </mxCell>
        <mxCell id="n_amr_arr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;" value="&lt;b&gt;4. ĐẾN TRẠM, KHÓA PHANH&lt;/b&gt;&lt;br&gt;Báo cáo: POST /api/amr/arrived" vertex="1">
          <mxGeometry height="60" width="260" x="40" y="490" as="geometry" />
        </mxCell>
        <mxCell id="n_srv_arr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Times New Roman;" value="&lt;b&gt;GHI NHẬN XE ĐỖ (BẬT CỜ ĐỎ)&lt;/b&gt;&lt;br&gt;Gán &lt;i&gt;amr_status = ARRIVED&lt;/i&gt;&lt;br&gt;(Từ lúc này, AMR gọi lên sẽ bị ép đứng chờ)" vertex="1">
          <mxGeometry height="60" width="260" x="360" y="490" as="geometry" />
        </mxCell>
        <mxCell id="n_cob_rdy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Times New Roman;" value="&lt;b&gt;5. MỞ KHÓA GẮP HÀNG&lt;/b&gt;&lt;br&gt;GET /api/cobot/current_task&lt;br&gt;Server thấy chữ ARRIVED liền cấp:&lt;br&gt;&lt;b&gt;status &amp;quot;ready&amp;quot; + Tọa độ (pose_id)&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="260" x="680" y="580" as="geometry" />
