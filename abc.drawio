        <mxCell id="n_cob_put" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Times New Roman;" value="&lt;b&gt;BÁO CÁO LẤP LỖ TRỐNG&lt;/b&gt;&lt;br&gt;POST /records/quantity" vertex="1">
