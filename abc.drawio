        <mxCell id="n_cob_gap" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Times New Roman;" value="&lt;b&gt;THỰC THI GẮP THẢ HÀNG&lt;/b&gt;&lt;br&gt;Vung tay theo tọa độ pose_id được cấp." vertex="1">
          <mxGeometry height="60" width="260" x="680" y="690" as="geometry" />
